# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/airbnb
DATABASE_POOL_SIZE=20

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=airbnb-consumer-group
KAFKA_TOPIC_LISTINGS=airbnb-listings
KAFKA_TOPIC_BOOKINGS=airbnb-bookings

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=airbnb-assets

# Application Configuration
APP_ENV=production
APP_PORT=8080
JWT_SECRET=your-jwt-secret-key
SESSION_SECRET=your-session-secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

